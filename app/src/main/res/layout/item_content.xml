<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta usada para Conceptos, Tips, Videos y Recursos.
     El ícono de "play" solo se muestra cuando el ítem es un video.
     subconceptosContainer solo se usa en Conceptos que traigan
     subconceptos (ver ContentItem.subconceptos); si no hay ninguno,
     queda oculto y la tarjeta se ve igual que antes. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="16dp"
    app:cardBackgroundColor="#2C333D"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:id="@+id/imagePlay"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/cd_reproducir"
                android:src="@drawable/ic_play"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/blanco_crema"
                    android:textSize="16sp"
                    tools:text="Título del concepto" />

                <TextView
                    android:id="@+id/textDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:textColor="@color/greige"
                    android:textSize="13sp"
                    tools:text="Descripción corta que explica el concepto de forma sencilla." />

                <!-- Autor: solo se muestra si el ítem trae ContentItem.autor
                     (típicamente en Videos). Oculto por defecto. -->
                <TextView
                    android:id="@+id/textAutor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/gris_input"
                    android:textSize="12sp"
                    android:textStyle="italic"
                    android:visibility="gone"
                    tools:text="Por: Nombre del autor"
                    tools:visibility="visible" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/buttonFavorito"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_favorito"
                android:padding="4dp"
                android:src="@drawable/ic_heart_border" />

        </LinearLayout>

        <!-- Subconceptos: se llenan por código en ContentAdapter. Vacío y
             oculto por defecto. -->
        <LinearLayout
            android:id="@+id/subconceptosContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.cardview.widget.CardView>