<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gris_carbon">

    <!-- Estrellas: empiezan arriba, fuera de pantalla (translationY negativo
         puesto por código) y caen con destello mientras dura el splash. -->
    <ImageView
        android:id="@+id/starOne"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="48dp"
        android:layout_marginTop="24dp"
        android:alpha="0"
        android:contentDescription="@null"
        android:src="@drawable/ic_star" />

    <ImageView
        android:id="@+id/starTwo"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="110dp"
        android:layout_marginTop="60dp"
        android:alpha="0"
        android:contentDescription="@null"
        android:src="@drawable/ic_star" />

    <ImageView
        android:id="@+id/starThree"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="16dp"
        android:alpha="0"
        android:contentDescription="@null"
        android:src="@drawable/ic_star" />

    <ImageView
        android:id="@+id/starFour"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="100dp"
        android:layout_marginTop="72dp"
        android:alpha="0"
        android:contentDescription="@null"
        android:src="@drawable/ic_star" />

    <ImageView
        android:id="@+id/starFive"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="40dp"
        android:layout_marginTop="32dp"
        android:alpha="0"
        android:contentDescription="@null"
        android:src="@drawable/ic_star" />

    <!-- Logo + textos, centrados como antes -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Logo: PLACEHOLDER, reemplazar drawable/ic_logo_placeholder por el real -->
        <ImageView
            android:id="@+id/imageLogo"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_logo_placeholder" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/app_name"
            android:textColor="@color/blanco_crema"
            android:textSize="32sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/dancing_script"
            android:text="@string/splash_frase"
            android:textColor="@color/greige"
            android:textSize="24sp" />

    </LinearLayout>

</FrameLayout>